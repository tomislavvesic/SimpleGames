{
  "name": "simple-games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:unit && vite build && npm run check:bundle",
    "test": "node --test",
    "test:unit": "node --test",
    "test:integration": "node scripts/multiplayer-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:deploy": "wrangler deploy --dry-run",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "playwright-core": "^1.62.0",
    "vite": "^7.0.0",
    "wrangler": "^4.68.0"
  }
}
